# syntax=docker/dockerfile:1

ARG UV_VERSION=0.12.4
ARG PYTHON_BASE=python:3.11-slim-bookworm

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv
FROM ${PYTHON_BASE} AS builder

ARG SW_PROJECT
ARG SW_VERSION
ARG SW_BUILD_ID
ARG SW_BUILD_IDENTITY
ARG SW_GIT_COMMIT
ARG SW_GIT_DESCRIBE
ARG SW_DIRTY_TREE
ARG SW_BUILD_SOURCE_TIMESTAMP
ARG SW_SOURCE_DATE_EPOCH
ARG SW_IMAGE_PROFILE
ARG SW_TARGET_PLATFORM
ARG SW_PYTHON_VERSION
ARG SW_SWWP_PROTOCOL_VERSIONS
ARG SW_JOB_PAYLOAD_SCHEMA_VERSIONS
ARG SW_JOB_RESULT_SCHEMA_VERSIONS
ARG SW_VALIDATION_PROTOCOL_VERSIONS
ARG SW_CONFIG_SCHEMA_MIN
ARG SW_CONFIG_SCHEMA_MAX
ARG SW_DIAGNOSTIC_SCHEMA_VERSION
ARG SW_DIAGNOSTIC_CATALOG_VERSION
ARG SW_CAPABILITY_MANIFEST_VERSION
ARG TARGETARCH
ARG VOICETEXT_ARCHIVE_URL="https://cdn.dondaplayer.com/WeatherRadioSuite-LIB.zip"
ARG VOICETEXT_ARCHIVE_SHA256="441ac30ea4bf899f81896f374b330860c5e9022601ca2b3e3c8cbf89e33fa8f5"
ARG SPEECHIFY_RELEASE_URL="https://github.com/wagwan-piffting-blud/Speechify/releases/download/2026.08.23/spfy-linux-x86_64-2026.08.23.tar.gz"
ARG SPEECHIFY_RELEASE_SHA256="3e57df579281a6a0c0e7c1a6233a269617bba2e761b08047918069883f84ed49"
ARG SPEECHIFY_COMMIT="7f28fb751a02b2981358d690f9df3651628c8151"
ARG SPEECHIFY_RAW_BASE_URL="https://raw.githubusercontent.com/wagwan-piffting-blud/Speechify"

RUN case "${SW_IMAGE_PROFILE}" in \
        routine-worker|piper|legacy-tts|voicetext-paul|spfy|maintenance|development) ;; \
        *) echo "unsupported worker image profile: ${SW_IMAGE_PROFILE}" >&2; exit 1 ;; \
    esac

ENV PATH="/opt/venv/bin:${PATH}" \
    UV_PROJECT_ENVIRONMENT="/opt/venv" \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_SEASONALWEATHER="${SW_VERSION}" \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SW_PROJECT="${SW_PROJECT}" \
    SW_VERSION="${SW_VERSION}" \
    SW_BUILD_ID="${SW_BUILD_ID}" \
    SW_BUILD_IDENTITY="${SW_BUILD_IDENTITY}" \
    SW_GIT_COMMIT="${SW_GIT_COMMIT}" \
    SW_GIT_DESCRIBE="${SW_GIT_DESCRIBE}" \
    SW_DIRTY_TREE="${SW_DIRTY_TREE}" \
    SW_BUILD_SOURCE_TIMESTAMP="${SW_BUILD_SOURCE_TIMESTAMP}" \
    SW_SOURCE_DATE_EPOCH="${SW_SOURCE_DATE_EPOCH}" \
    SW_IMAGE_PROFILE="${SW_IMAGE_PROFILE}" \
    SW_TARGET_PLATFORM="${SW_TARGET_PLATFORM}" \
    SW_PYTHON_VERSION="${SW_PYTHON_VERSION}" \
    SW_SWWP_PROTOCOL_VERSIONS="${SW_SWWP_PROTOCOL_VERSIONS}" \
    SW_JOB_PAYLOAD_SCHEMA_VERSIONS="${SW_JOB_PAYLOAD_SCHEMA_VERSIONS}" \
    SW_JOB_RESULT_SCHEMA_VERSIONS="${SW_JOB_RESULT_SCHEMA_VERSIONS}" \
    SW_VALIDATION_PROTOCOL_VERSIONS="${SW_VALIDATION_PROTOCOL_VERSIONS}" \
    SW_CONFIG_SCHEMA_MIN="${SW_CONFIG_SCHEMA_MIN}" \
    SW_CONFIG_SCHEMA_MAX="${SW_CONFIG_SCHEMA_MAX}" \
    SW_DIAGNOSTIC_SCHEMA_VERSION="${SW_DIAGNOSTIC_SCHEMA_VERSION}" \
    SW_DIAGNOSTIC_CATALOG_VERSION="${SW_DIAGNOSTIC_CATALOG_VERSION}" \
    SW_CAPABILITY_MANIFEST_VERSION="${SW_CAPABILITY_MANIFEST_VERSION}"

WORKDIR /build
RUN python -m venv /opt/venv

COPY --from=uv /uv /uvx /usr/local/bin/
COPY pyproject.toml uv.lock README.md ./
RUN case "${SW_IMAGE_PROFILE}" in \
        piper) uv sync --frozen --no-dev --group worker-runtime --group piper --no-install-project ;; \
        routine-worker|legacy-tts|voicetext-paul|spfy|maintenance|development) uv sync --frozen --no-dev --group worker-runtime --no-install-project ;; \
        *) echo "unsupported worker image profile: ${SW_IMAGE_PROFILE}" >&2; exit 1 ;; \
    esac

COPY docker/spfy/voice-manifest.txt /tmp/spfy-voice-manifest.txt
RUN set -eux; \
    mkdir -p /var/lib/seasonalweather/voices/voicetext_paul/WeatherRadioSuite-LIB /opt/spfy; \
    case "${SW_IMAGE_PROFILE}" in \
      voicetext-paul) \
        apt-get update; \
        apt-get install --yes --no-install-recommends ca-certificates curl unzip; \
        curl --fail --location --retry 5 --retry-all-errors \
          --connect-timeout 30 --max-time 1800 \
          --output /tmp/WeatherRadioSuite-LIB.zip "${VOICETEXT_ARCHIVE_URL}"; \
        echo "${VOICETEXT_ARCHIVE_SHA256}  /tmp/WeatherRadioSuite-LIB.zip" | sha256sum --check --strict -; \
        mkdir -p /tmp/voicetext-unpacked; \
        unzip -q /tmp/WeatherRadioSuite-LIB.zip -d /tmp/voicetext-unpacked; \
        if [ -f /tmp/voicetext-unpacked/binary/voicetext_paul.exe ]; then \
          cp -a /tmp/voicetext-unpacked/. /var/lib/seasonalweather/voices/voicetext_paul/WeatherRadioSuite-LIB/; \
        elif [ -f /tmp/voicetext-unpacked/WeatherRadioSuite-LIB/binary/voicetext_paul.exe ]; then \
          cp -a /tmp/voicetext-unpacked/WeatherRadioSuite-LIB/. \
            /var/lib/seasonalweather/voices/voicetext_paul/WeatherRadioSuite-LIB/; \
        else \
          echo "VoiceText archive does not contain binary/voicetext_paul.exe" >&2; exit 1; \
        fi; \
        test -f /var/lib/seasonalweather/voices/voicetext_paul/WeatherRadioSuite-LIB/binary/voicetext_paul.exe; \
        rm -rf /tmp/WeatherRadioSuite-LIB.zip /tmp/voicetext-unpacked; \
        apt-get purge --yes curl unzip; \
        rm -rf /var/lib/apt/lists/* ;; \
      spfy) \
        case "${TARGETARCH:-amd64}" in amd64) ;; *) echo "spfy worker supports only linux/amd64" >&2; exit 1 ;; esac; \
        apt-get update; \
        apt-get install --yes --no-install-recommends ca-certificates curl tar; \
        curl --fail --location --retry 5 --retry-all-errors \
          --connect-timeout 30 --max-time 1800 \
          --output /tmp/spfy.tar.gz "${SPEECHIFY_RELEASE_URL}"; \
        echo "${SPEECHIFY_RELEASE_SHA256}  /tmp/spfy.tar.gz" | sha256sum --check --strict -; \
        mkdir -p /tmp/spfy-release /opt/spfy/bin; \
        tar -xzf /tmp/spfy.tar.gz -C /tmp/spfy-release --wildcards '*/bin/spfy_synth'; \
        spfy_binary="$(find /tmp/spfy-release -type f -name spfy_synth -print -quit)"; \
        test -n "${spfy_binary}"; install -m 0755 "${spfy_binary}" /opt/spfy/bin/spfy_synth; \
        while read -r path checksum; do \
          case "${path}" in ''|'#'*) continue ;; esac; \
          destination="/opt/spfy/${path}"; mkdir -p "$(dirname "${destination}")"; \
          curl --fail --location --retry 5 --retry-all-errors \
            --connect-timeout 30 --max-time 1800 \
            --output "${destination}" "${SPEECHIFY_RAW_BASE_URL}/${SPEECHIFY_COMMIT}/${path}"; \
          echo "${checksum}  ${destination}" | sha256sum --check --strict -; \
        done < /tmp/spfy-voice-manifest.txt; \
        test -x /opt/spfy/bin/spfy_synth; test -d /opt/spfy/en-US/tom; \
        rm -rf /tmp/spfy.tar.gz /tmp/spfy-release; \
        apt-get purge --yes curl; \
        rm -rf /var/lib/apt/lists/* ;; \
      *) rm -f /tmp/spfy-voice-manifest.txt ;; \
    esac
RUN rm -f /tmp/spfy-voice-manifest.txt

COPY seasonalweather ./seasonalweather
RUN uv pip install --python /opt/venv/bin/python --no-deps .

# Worker images do not carry controller-only authorities or source adapters.
RUN python - <<'PY'
import shutil
import sysconfig
from pathlib import Path

package_root = Path(sysconfig.get_paths()["purelib"]) / "seasonalweather"
for name in (
    "alerts",
    "api",
    "artifacts",
    "broadcast",
    "commands",
    "configuration_reload",
    "database",
    "job_store",
    "nwws",
    "same",
    "config.py",
    "control.py",
    "discord_log.py",
    "health_service.py",
    "lifecycle.py",
    "liquidsoap_telnet.py",
    "main.py",
):
    target = package_root / name
    if target.is_dir():
        shutil.rmtree(target)
    else:
        target.unlink(missing_ok=True)
PY

RUN mkdir -p /usr/share/seasonalweather/diagnostics \
    && seasonalweather diagnostics export --output /usr/share/seasonalweather/diagnostics

RUN mkdir -p /usr/share/seasonalweather \
    && python - <<'PY'
import os
from pathlib import Path

from seasonalweather.build_metadata import BuildInfo


def versions(name: str) -> tuple[int, ...]:
    return tuple(int(item) for item in os.environ[name].split(",") if item)


raw_epoch = os.environ["SW_SOURCE_DATE_EPOCH"]
info = BuildInfo(
    schema_version=1,
    project=os.environ["SW_PROJECT"],
    software_version=os.environ["SW_VERSION"],
    git_commit=os.environ["SW_GIT_COMMIT"],
    git_describe=os.environ["SW_GIT_DESCRIBE"],
    dirty_tree=os.environ["SW_DIRTY_TREE"].lower() == "true",
    build_source_timestamp=os.environ["SW_BUILD_SOURCE_TIMESTAMP"] or None,
    source_date_epoch=int(raw_epoch) if raw_epoch else None,
    build_id=os.environ["SW_BUILD_ID"],
    image_profile=os.environ["SW_IMAGE_PROFILE"],
    target_platform=os.environ["SW_TARGET_PLATFORM"],
    python_version=os.environ["SW_PYTHON_VERSION"],
    swwp_protocol_versions=versions("SW_SWWP_PROTOCOL_VERSIONS"),
    job_payload_schema_versions=versions("SW_JOB_PAYLOAD_SCHEMA_VERSIONS"),
    job_result_schema_versions=versions("SW_JOB_RESULT_SCHEMA_VERSIONS"),
    validation_protocol_versions=versions("SW_VALIDATION_PROTOCOL_VERSIONS"),
    configuration_schema=(int(os.environ["SW_CONFIG_SCHEMA_MIN"]), int(os.environ["SW_CONFIG_SCHEMA_MAX"])),
    diagnostic_schema_version=int(os.environ["SW_DIAGNOSTIC_SCHEMA_VERSION"]),
    diagnostic_catalog_version=int(os.environ["SW_DIAGNOSTIC_CATALOG_VERSION"]),
    capability_manifest_version=int(os.environ["SW_CAPABILITY_MANIFEST_VERSION"]),
)
Path("/usr/share/seasonalweather/build-info.json").write_text(info.to_json() + "\n", encoding="utf-8")
PY

FROM ${PYTHON_BASE} AS worker

ARG SW_IMAGE_PROFILE
ARG TARGETARCH
ARG VOICETEXT_ARCHIVE_URL="https://cdn.dondaplayer.com/WeatherRadioSuite-LIB.zip"
ARG VOICETEXT_ARCHIVE_SHA256="441ac30ea4bf899f81896f374b330860c5e9022601ca2b3e3c8cbf89e33fa8f5"
ARG SPEECHIFY_RELEASE_URL="https://github.com/wagwan-piffting-blud/Speechify/releases/download/2026.08.23/spfy-linux-x86_64-2026.08.23.tar.gz"
ARG SPEECHIFY_RELEASE_SHA256="3e57df579281a6a0c0e7c1a6233a269617bba2e761b08047918069883f84ed49"
ARG SPEECHIFY_COMMIT="7f28fb751a02b2981358d690f9df3651628c8151"
RUN case "${SW_IMAGE_PROFILE}" in \
        routine-worker|piper|legacy-tts|voicetext-paul|spfy|maintenance|development) ;; \
        *) exit 1 ;; \
    esac

LABEL io.seasonalweather.security.profile="worker" \
      io.seasonalweather.security.user="seasonalweather:10001:10001" \
      io.seasonalweather.security.read-only-root="required" \
      io.seasonalweather.security.no-new-privileges="required" \
      io.seasonalweather.security.cap-drop="ALL" \
      io.seasonalweather.security.tmpfs="/tmp,/run" \
      io.seasonalweather.security.secrets="read-only-per-service"

LABEL io.seasonalweather.voicetext.archive-url="${VOICETEXT_ARCHIVE_URL}" \
      io.seasonalweather.voicetext.archive-sha256="${VOICETEXT_ARCHIVE_SHA256}" \
      io.seasonalweather.speechify.release-url="${SPEECHIFY_RELEASE_URL}" \
      io.seasonalweather.speechify.release-sha256="${SPEECHIFY_RELEASE_SHA256}" \
      io.seasonalweather.speechify.source-commit="${SPEECHIFY_COMMIT}"

ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN set -eux; \
    case "${SW_IMAGE_PROFILE}" in \
      routine-worker) packages="ffmpeg espeak-ng" ;; \
      legacy-tts) packages="festival" ;; \
      voicetext-paul) \
        case "${TARGETARCH:-amd64}" in amd64) ;; *) echo "VoiceText Paul worker supports only linux/amd64" >&2; exit 1 ;; esac; \
        dpkg --add-architecture i386; \
        apt-get update; \
        apt-get install --yes --no-install-recommends bash ca-certificates sudo wine wine32:i386 x11-utils xvfb; \
        rm -rf /var/lib/apt/lists/*; \
        groupadd --system --gid 10002 voicetext; \
        useradd --system --uid 10002 --gid 10002 --home-dir /home/voicetext --create-home --shell /usr/sbin/nologin voicetext; \
        install -d -o voicetext -g voicetext /var/lib/seasonalweather/voices/voicetext_paul /var/lib/seasonalweather/wineprefixes /tmp/voicetext; \
        chown -R voicetext:voicetext /var/lib/seasonalweather/voices/voicetext_paul /var/lib/seasonalweather/wineprefixes /tmp/voicetext ;; \
      spfy) \
        case "${TARGETARCH:-amd64}" in amd64) ;; *) echo "spfy worker supports only linux/amd64" >&2; exit 1 ;; esac ;; \
      *) packages="" ;; \
    esac; \
    if [ -n "${packages:-}" ]; then apt-get update && apt-get install --yes --no-install-recommends ${packages} && rm -rf /var/lib/apt/lists/*; fi

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /usr/share/seasonalweather /usr/share/seasonalweather
COPY --from=builder /opt/spfy /opt/spfy
COPY --from=builder /var/lib/seasonalweather/voices/voicetext_paul /var/lib/seasonalweather/voices/voicetext_paul
COPY scripts/wrappers/voicetext_paul_synth scripts/wrappers/voicetext_paul_wineserver_kill /usr/local/bin/
COPY scripts/worker/voicetext-paul-entrypoint /usr/local/bin/voicetext-paul-entrypoint

RUN groupadd --gid 10001 seasonalweather \
    && useradd --uid 10001 --gid 10001 --home-dir /nonexistent --no-create-home \
        --shell /usr/sbin/nologin seasonalweather \
    && install -d -o 10001 -g 10001 /var/lib/seasonalweather/artifacts /var/lib/seasonalweather/artifacts/audio

RUN case "${SW_IMAGE_PROFILE}" in \
      voicetext-paul) \
        chmod 0755 /usr/local/bin/voicetext_paul_synth /usr/local/bin/voicetext_paul_wineserver_kill /usr/local/bin/voicetext-paul-entrypoint; \
        chown -R voicetext:voicetext /var/lib/seasonalweather/voices/voicetext_paul; \
        printf '%s\n' \
          'seasonalweather ALL=(voicetext) NOPASSWD: /usr/local/bin/voicetext_paul_synth' \
          'seasonalweather ALL=(voicetext) NOPASSWD: /usr/local/bin/voicetext_paul_wineserver_kill' \
          > /etc/sudoers.d/seasonalweather-voicetext-paul; \
        chmod 0440 /etc/sudoers.d/seasonalweather-voicetext-paul ;; \
      *) rm -f /usr/local/bin/voicetext_paul_synth /usr/local/bin/voicetext_paul_wineserver_kill /usr/local/bin/voicetext-paul-entrypoint ;; \
    esac

WORKDIR /opt/seasonalweather
USER seasonalweather

HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
    CMD ["python", "-m", "seasonalweather", "health", "worker", "--mode", "liveness"]
ENTRYPOINT ["python", "-m", "seasonalweather", "worker"]
